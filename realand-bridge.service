[Unit]
Description=Realand Biometric Terminal UDP Cloud Bridge
After=network.target

[Service]
Type=simple
User=your-username
WorkingDirectory=/path/to/realand-bridge
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=PORT=11898
Environment=SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co/functions/v1/attendance-log
Environment=SUPABASE_SERVICE_KEY=

# Hardening
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
