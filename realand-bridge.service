After=network.target

[Service]
Type=simple
User=semilore
WorkingDirectory=/home/semilore/realand-local-bridge
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=PORT=11898
Environment=SUPABASE_URL=https://kkltrgjszsuozlrnjrnb.supabase.co/functions/v1/attendance-log
