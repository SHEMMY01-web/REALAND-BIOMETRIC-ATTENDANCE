# ─── Realand UDP Bridge Configuration ───────────────────────────────────────

# UDP Listener Port (Must match the Server Port configured on the Realand terminal)
PORT=11898

# Cloud Webhook / Supabase Edge Function URL
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co/functions/v1/attendance-log

# Supabase Service Key or Anon Key (optional if public function)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
